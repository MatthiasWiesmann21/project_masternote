{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MasterNote",
  "version": "0.1.0",
  "identifier": "com.masternote.desktop",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MasterNote",
        "width": 790,
        "height": 570,
        "minWidth": 480,
        "minHeight": 320,
        "maxWidth": 1400,
        "maxHeight": 1000,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "center": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true,
      "tooltip": "MasterNote"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Fast quick-note widget",
    "longDescription": "MasterNote — a fast cross-platform quick-note widget app with SQLite storage, tags, full-text search, reminders, and Outlook calendar integration."
  },
  "plugins": {}
}
